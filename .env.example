# Copy this file to .env and fill in the values.  (cp .env.example .env)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# 1 when the API runs behind Railway / Render / Nginx (so rate limits see the real client IP)
TRUST_PROXY=0

# Local Docker values. For MongoDB Atlas use the connection string from Atlas → Connect → Drivers.
MONGODB_URI=mongodb://localhost:27017/insurance?directConnection=true
REDIS_URL=redis://localhost:6379

# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-characters
OTP_SECRET=change-me-to-another-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Web origins allowed to call the API (web admin panel), comma separated. The mobile app needs nothing here.
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# SMS: "console" prints messages to the server log; "msg91" sends real SMS (see README → Part 5 → SMS)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
# MSG91 template id of each SMS (each linked to its DLT template), as kind=id pairs:
#   otp, account_approved, staff_invite, plan_renewal, trial_ending
MSG91_TEMPLATE_IDS=
# Development/staging only: every OTP is this code. Leave empty for random codes. Never set in production.
OTP_FIXED_CODE=123456

# Customer messages. WhatsApp: "console" or "meta" (WhatsApp Cloud API). Email: "console" or "smtp".
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
EMAIL_PROVIDER=console
# smtps://USER:PASSWORD@HOST:465  (Amazon SES, Brevo, Zoho Mail, Google Workspace …)
SMTP_URL=
EMAIL_FROM=Insurance Advisor <no-reply@yourdomain.in>

# Customer documents (KYC). "local" stores files in UPLOADS_DIR; "s3" = private bucket (AWS S3 / Cloudflare R2).
STORAGE_DRIVER=local
S3_BUCKET=
# AWS: ap-south-1 (Mumbai). Cloudflare R2: auto, and set S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10
FILE_URL_SECRET=change-me-to-a-third-long-random-string-of-48-chars
FILE_URL_TTL_SEC=900

# Public address of this API (used in payment links). On a phone use your laptop IP, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL=http://localhost:4000

# Payments: "mock" = practice checkout page, no real money. "razorpay" needs the three keys below
# (Razorpay Dashboard → Account & Settings → API Keys / Webhooks; use Test Mode keys first).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_EXPIRY_HOURS=72
QUOTE_VALIDITY_DAYS=30

# Background jobs (npm run worker)
RENEWAL_REMINDER_DAYS=30,7,1
PAYMENT_REMINDER_AFTER_HOURS=24
PLAN_REMINDER_DAYS=3

RATE_LIMIT_ENABLED=true
API_DOCS_ENABLED=true

# Used by "npm run seed"
SEED_PASSWORD=Demo@1234
